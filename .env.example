# Database — Neon PostgreSQL
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
# Staging/Prod: Use pooled endpoint (ep-[project]-[pool].c.[region].aws.neon.tech:5432)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c.region.aws.neon.tech:5432/driven_group?sslmode=require"

# Authentication (NextAuth v5 - future)
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Image uploads — Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="driven-group/properties"

# Lead notifications — Resend
RESEND_API_KEY=""
LEAD_NOTIFICATION_EMAIL="administracion@drivengroup.com.mx"
LEAD_FROM_EMAIL="Driven Group <onboarding@resend.dev>"
